# ==============================================================================
# JazzHub Production Environment Variables Template
# ==============================================================================
# Copy this file to server/.env on your server: cp .env.example server/.env
# Fill in your actual production values. NEVER commit the real .env file to git.
# ==============================================================================

# Server Environment & Port
NODE_ENV=production
PORT=5000

# TMDB (The Movie Database) API Configuration
# Obtain your free API key at: https://www.themoviedb.org/settings/api
TMDB_API_KEY=YOUR_TMDB_API_KEY

# CORS Frontend Allowed Origin
# For initial deployment: http://YOUR_EC2_PUBLIC_IP
# When domain is connected: https://yourdomain.com
FRONTEND_URL=http://YOUR_EC2_PUBLIC_IP

# Optional: Comma-separated list of additional allowed origins
ADDITIONAL_ALLOWED_ORIGINS=

# Optional: External Authorized Playback Provider Endpoint
PLAYBACK_PROVIDER_URL=
PLAYBACK_PROVIDER_API_KEY=YOUR_KEY

# Optional: Set to true only if you want local public demo streams when no provider is configured
ALLOW_DEMO_PLAYBACK=false
